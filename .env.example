# Puro Pockets: variables de entorno (EJEMPLO, sin valores reales)
# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.

# --- Base de datos (Hito 1) ---
POSTGRES_DB=puro_pockets
POSTGRES_USER=puro_pockets
POSTGRES_PASSWORD=cambia-esta-contrasena
# El puerto se publica solo en 127.0.0.1
POSTGRES_PORT=5432

# URL de conexión para usar desde el equipo (pruebas de integración, Alembic local).
# Dentro de Docker Compose el servicio mcp usa el host "db" (docker-compose.yml la arma sola).
DATABASE_URL=postgresql+psycopg://puro_pockets:cambia-esta-contrasena@localhost:5432/puro_pockets

# Tiempo límite de conexión a la base, en segundos (lo usa la tool ping)
DB_CONNECT_TIMEOUT=2

# --- Servidor MCP (Hito 1) ---
# Dirección y puerto en el equipo; el puerto se publica solo en 127.0.0.1
MCP_HOST=127.0.0.1
MCP_PORT=8000

# --- Túnel de Cloudflare (Hito 2) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- OAuth (Hito 3) ---
# Las variables se definen cuando se decida el servidor de autorización (ver HITOS.md, Hito 3).
