# Puro Pockets: variables de entorno (EJEMPLO, sin valores reales)
# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.

# --- Base de datos (Hito 1) ---
POSTGRES_DB=puro_pockets
POSTGRES_USER=puro_pockets
POSTGRES_PASSWORD=cambia-esta-contrasena
# El puerto se publica solo en 127.0.0.1
POSTGRES_PORT=5432

# URL de conexión para usar desde el equipo (pruebas de integración, Alembic local).
# Usa 127.0.0.1, no "localhost": en Windows "localhost" puede intentar IPv6 primero y tardar.
# Dentro de Docker Compose el servicio mcp usa el host "db" (docker-compose.yml la arma sola).
DATABASE_URL=postgresql+psycopg://puro_pockets:cambia-esta-contrasena@127.0.0.1:5432/puro_pockets

# Tiempo límite de conexión a la base, en segundos (lo usa la tool ping)
DB_CONNECT_TIMEOUT=2

# --- Servidor MCP (Hito 1) ---
# Dirección y puerto en el equipo; el puerto se publica solo en 127.0.0.1
MCP_HOST=127.0.0.1
MCP_PORT=8000

# --- Acceso público (Hito 2) ---
# Nombre público del servidor MCP (no es secreto). El servidor acepta este encabezado Host
# además de los locales; cualquier otro se rechaza.
MCP_PUBLIC_HOSTNAME=mcp.puropockets.space
# Orígenes adicionales permitidos (separados por comas), por si el conector de Claude envía Origin
MCP_ALLOWED_ORIGINS=https://claude.ai,https://claude.com

# --- Túnel de Cloudflare (Hito 2) ---
# Token del túnel: SOLO en el .env del homelab. Déjalo vacío en el equipo de desarrollo.
# Nunca lo copies en el repositorio, en issues ni en chats.
CF_TUNNEL_TOKEN=
# Servicios opcionales de Compose. En el homelab: COMPOSE_PROFILES=tunnel (arranca el túnel).
# En el equipo de desarrollo, déjalo vacío.
COMPOSE_PROFILES=

# --- OAuth (Hito 3) ---
# Hash argon2 de la contraseña del propietario. Genéralo con: python scripts/hash_password.py
# Va ENTRE COMILLAS SIMPLES (el hash tiene '$'). Nunca pongas aquí la contraseña en texto plano.
# Vacío = nadie puede iniciar sesión (el servidor arranca, pero no emite tokens).
OWNER_PASSWORD_HASH=''

# Emisor y recurso OAuth. Vacíos = se derivan de MCP_PUBLIC_HOSTNAME:
#   emisor  https://mcp.puropockets.space   recurso  https://mcp.puropockets.space/mcp
OAUTH_ISSUER_URL=
OAUTH_RESOURCE_URL=
# URL de retorno permitidas (separadas por comas). Vacío = las de claude.ai y claude.com.
OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Registro dinámico de clientes: CERRADO por defecto. Pon true solo mientras agregas el conector
# en claude.ai y vuelve a false después (ver README, Hito 3).
OAUTH_REGISTRATION_ENABLED=false
OAUTH_MAX_CLIENTS=10

# Duraciones en segundos (vacías = acceso 3600, refresco 2592000 = 30 días, código 300).
OAUTH_ACCESS_TOKEN_TTL_SECONDS=
OAUTH_REFRESH_TOKEN_TTL_SECONDS=
OAUTH_AUTH_CODE_TTL_SECONDS=
# Duraciones cortas para probar el refresco (acceso 2 min, refresco 15 min). Solo para pruebas.
OAUTH_SHORT_LIFETIMES=false

# --- Presupuesto (Hito 4) ---
# Zona horaria del propietario: define el "mes actual" (porcentajes, saldo inicial).
APP_TIMEZONE=America/Costa_Rica

# --- Movimientos (Hito 5) ---
# Rango aceptado del tipo de cambio, en colones por dólar (enteros, inclusivo). Un movimiento en USD
# con un tipo de cambio fuera de este rango se rechaza.
USD_RATE_MIN=300
USD_RATE_MAX=1000

# --- Dashboard (Hito 10) ---
# Solo arranca con el perfil "dashboard" (en el homelab: COMPOSE_PROFILES=tunnel,dashboard).
# URL del rol de SOLO LECTURA creado con scripts/create_dashboard_role.sql (host "db" dentro de
# Compose). NO uses aquí el rol propietario: el dashboard se niega a arrancar si puede escribir.
DASHBOARD_DATABASE_URL=postgresql+psycopg://puro_dashboard:cambia-esta-contrasena@db:5432/puro_pockets
# Secreto para firmar la cookie de sesión (mínimo 32 bytes). Genéralo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SESSION_SECRET=
# Cookie solo por HTTPS. Déjalo en true con túnel SSH (http://127.0.0.1 cuenta como seguro);
# ponlo en false solo si entras por http a una IP de Tailscale o de la red local.
DASHBOARD_COOKIE_SECURE=true
# IP donde se publica el puerto: 127.0.0.1 (solo el homelab; entra con túnel SSH) o la IP privada
# de Tailscale del homelab (100.x.y.z). NUNCA 0.0.0.0 ni una IP pública.
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=8080
# Publicación por Cloudflare (opcional): los TRES juntos o ninguno. El dashboard solo acepta lo que
# llega por Cloudflare con un token válido de Cloudflare Access (ver README, "Dashboard").
#   DASHBOARD_PUBLIC_HOSTNAME  nombre público del túnel, p. ej. dash.puropockets.space
#   CF_ACCESS_TEAM_DOMAIN      dominio del equipo de Zero Trust: <equipo>.cloudflareaccess.com
#   CF_ACCESS_AUD              "Application Audience (AUD) Tag" de la aplicación de Access
DASHBOARD_PUBLIC_HOSTNAME=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
